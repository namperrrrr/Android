<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPromoFormTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="THÊM MÃ KHUYẾN MÃI"
        android:textAlignment="center"
        android:textColor="#1976D2"
        android:textSize="22sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="#1976D2"
        app:hintTextColor="#1976D2">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtPromoCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mã giảm giá (VD: TET2026) (*)"
            android:inputType="textCapCharacters" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="#1976D2"
        app:hintTextColor="#1976D2">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtPromoDiscount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mức giảm (VD: 50.000đ) (*)"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="#1976D2"
        app:hintTextColor="#1976D2">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtPromoDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả điều kiện áp dụng"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:boxStrokeColor="#1976D2"
        app:hintTextColor="#1976D2">

        <AutoCompleteTextView
            android:id="@+id/edtPromoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Trạng thái"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSavePromo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#1976D2"
        android:text="LƯU KHUYẾN MÃI"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>